# Infrastructure settings for the local stack — copy to .env (deploy.sh does this for you). Docker Compose reads it
# from the repository root. The values match the service .env.example files, so a fresh checkout works as-is; if you
# change one, change its twin in the service .env files too (noted below).
COMPOSE_PROJECT_NAME=drift

# The port the app is served on: http://localhost:8080
EDGE_PORT=8080

# PostgreSQL — one instance, four databases (users_db, rooms_db, messages_db, files_db) that deploy.sh creates.
# Twin: DATABASE_USERNAME / DATABASE_PASSWORD in every backend/<service>/.env.
POSTGRES_USER=drift
POSTGRES_PASSWORD=change-me

# MinIO. Twin of MINIO_SECRET_KEY in backend/file-service/.env. MINIO_KMS_SECRET_KEY ("key-name:base64 of 32 bytes",
# make one with `openssl rand -base64 32`) turns on server-side encryption at rest.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_KMS_SECRET_KEY=drift-local-key:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Grafana admin login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-change-me
