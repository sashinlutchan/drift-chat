// Grafana Alloy (spec section 26): one agent for logs and traces.
//   logs   : container stdout of every service in this Compose project -> Loki (labels: service, level)
//   traces : OTLP from the services (HTTP 4318 / gRPC 4317) -> Tempo

logging {
  level = "info"
}

// ── logs ────────────────────────────────────────────────────────────────────────────────────────────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=drift"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.json.receiver]
}

// The services log one JSON object per line (Spring Boot structured logging) and nginx does too, so the level and
// the trace id can be pulled out for filtering and for the log -> trace link in Grafana.
loki.process "json" {
  stage.json {
    expressions = { level = "level", traceId = "traceId" }
  }
  stage.labels {
    values = { level = "" }
  }
  stage.structured_metadata {
    values = { traceId = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ── traces ──────────────────────────────────────────────────────────────────────────────────────────────────────
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
