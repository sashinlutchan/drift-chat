# frontend configuration (spec section 20) — copy to .env for local runs.
# Same-origin paths so the session cookie is always sent; in development the
# Vite dev server proxies /api and /socket.io.
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/
VITE_MAX_FILE_SIZE=1073741824
VITE_UPLOAD_CHUNK_SIZE=8388608
