# message-service configuration (spec section 20) — copy to .env for local runs
SPRING_PROFILES_ACTIVE=default
SERVICE_NAME=message-service
LOG_LEVEL=INFO
HTTP_PORT=8083
GRPC_PORT=9083
MANAGEMENT_PORT=8183

DATABASE_URL=jdbc:postgresql://localhost:5432/messages_db
DATABASE_USERNAME=drift
DATABASE_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VALKEY_HOST=localhost
VALKEY_PORT=6379

JWT_SECRET=change-me-at-least-32-bytes-long-secret
SESSION_COOKIE_NAME=drift_session
# false because the local stack is served over plain http; set true behind HTTPS
COOKIE_SECURE=false

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SHUTDOWN_TIMEOUT=30s

# message-service specific
SOCKET_PORT=8090
ALLOWED_ORIGINS=https://localhost:8443
MESSAGE_ENCRYPTION_KEY=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtMzI=
MAX_MESSAGE_LENGTH=2000
MAX_FILE_SIZE=1GB
UPLOAD_CHUNK_SIZE=8MB
UPLOAD_SESSION_TTL=1h
HISTORY_PAGE_SIZE=50
USER_SERVICE_ADDR=localhost:9081
ROOM_SERVICE_ADDR=localhost:9082
FILE_SERVICE_ADDR=localhost:9084

JAVA_OPTS=-XX:MaxRAMPercentage=75.0
