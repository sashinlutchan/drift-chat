# file-service configuration (spec section 20) — copy to .env for local runs
SPRING_PROFILES_ACTIVE=default
SERVICE_NAME=file-service
LOG_LEVEL=INFO
HTTP_PORT=8084
GRPC_PORT=9084
MANAGEMENT_PORT=8184

DATABASE_URL=jdbc:postgresql://localhost:5432/files_db
DATABASE_USERNAME=drift
DATABASE_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VALKEY_HOST=localhost
VALKEY_PORT=6379

JWT_SECRET=change-me-at-least-32-bytes-long-secret
SESSION_COOKIE_NAME=drift_session
# false because the local stack is served over plain http; set true behind HTTPS
COOKIE_SECURE=false

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SHUTDOWN_TIMEOUT=30s

# file-service specific
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_AVATARS=drift-avatars
MINIO_BUCKET_MEDIA=drift-media
MINIO_KMS_SECRET_KEY=change-me-32-bytes-minimum-secret!!
MAX_FILE_SIZE=1GB
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,audio/mpeg,audio/ogg,audio/wav,audio/webm,video/mp4,video/webm
ROOM_SERVICE_ADDR=localhost:9082

JAVA_OPTS=-XX:MaxRAMPercentage=75.0
MAX_AVATAR_SIZE=5MB
