# room-service configuration (spec section 20) — copy to .env for local runs
SPRING_PROFILES_ACTIVE=default
SERVICE_NAME=room-service
LOG_LEVEL=INFO
HTTP_PORT=8082
GRPC_PORT=9082
MANAGEMENT_PORT=8182

DATABASE_URL=jdbc:postgresql://localhost:5432/rooms_db
DATABASE_USERNAME=drift
DATABASE_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VALKEY_HOST=localhost
VALKEY_PORT=6379

JWT_SECRET=change-me-at-least-32-bytes-long-secret
SESSION_COOKIE_NAME=drift_session
COOKIE_SECURE=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TLS_CERT_FILE=./certs/room-service.crt
TLS_KEY_FILE=./certs/room-service.key
TLS_CA_FILE=./certs/ca.crt
SHUTDOWN_TIMEOUT=30s

# room-service specific
ROOM_IDLE_TTL=24h
CLEANUP_INTERVAL=5m
USER_SERVICE_ADDR=localhost:9081
PUBLIC_BASE_URL=https://localhost:8443

JAVA_OPTS=-XX:MaxRAMPercentage=75.0
